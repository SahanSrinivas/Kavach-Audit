-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

# Negate at end so duplicate .env.* patterns above don't re-block these.
# .env.example files DO get committed (they're templates).
!.env.example
!backend/.env.example

# User-uploaded insurance PDFs (PII — policyholder name, policy number,
# sum insured, premium). These should never reach git history. They land
# at the repo root during local dogfooding (smoke tests, parser scripts).
*.pdf
# --- Insurance wording downloads ---
# Downloaded insurer policy wording PDFs are regeneratable artifacts,
# not source. Scripts that produce them are committed; outputs aren't.
# Logs and READMEs ARE committed for provenance.
wordings/*.pdf
wordings-latest/*.pdf
wordings-benchmark/*.pdf
# But DO check in spec docs and any sample PDFs we explicitly want versioned
!docs/**/*.pdf
