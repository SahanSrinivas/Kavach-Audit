# Kavachly backend environment template.
# Copy to backend/.env and fill in real values. Never commit backend/.env.

# ---------- Required ----------
MONGO_URL=mongodb://localhost:27017
DB_NAME=kavach
JWT_SECRET=                # generate with: openssl rand -hex 64
ANTHROPIC_API_KEY=         # from console.anthropic.com — used for PDF parsing

# ---------- Required in production (optional in dev) ----------
ADMIN_PASSWORD=            # passphrase format: word.word.word.word.number

# ---------- Mode flags ----------
USE_MOCKS=true                          # false → real Claude PDF parsing + real audit engine
ENVIRONMENT=development                 # production | development
PARSER_FALLBACK_TO_MOCK_ON_ERROR=false  # safety net for soft launch

# ---------- Auth tuning (defaults if unset) ----------
ACCESS_TOKEN_EXP_HOURS=1
REFRESH_TOKEN_EXP_DAYS=90

# ---------- Optional ----------
CORS_ORIGINS=http://localhost:3000
GIT_SHA=                   # populated by CI for /api/version
